        <mxCell id="test_container_50" value="<b>ATHER TEST LAB — ISOLATED SIMULATION &amp; FAULT INJECTION SANDBOX</b><br><span style='font-size:11px;font-weight:normal;color:#475569;'>Zero-Risk Verification Environment: Evaluates Synthetic Fault Scenarios using Cloned Production AnomalyDetector (Zero Live Telemetry Pollution)</span>" style="swimlane;whiteSpace=wrap;html=1;startSize=40;rounded=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontStyle=1;fontSize=15;fontColor=#6B21A8;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
