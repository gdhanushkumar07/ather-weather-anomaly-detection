        <mxCell id="leg_box_56" value="<b>ARCHITECTURE CONVENTIONS &amp; SCIENTIFIC FOUNDATION</b><br><span style='font-size:11px;font-weight:normal;color:#475569;'>Implementation Status, Mathematical Principles &amp; WMO Standards</span>" style="swimlane;whiteSpace=wrap;html=1;startSize=40;rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontStyle=1;fontSize=15;fontColor=#1E293B;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
